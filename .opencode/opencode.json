{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "klibs": {
      "type": "remote",
      "url": "https://api.klibs.io/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    }
  }
}
